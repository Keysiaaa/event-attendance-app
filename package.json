{
  "name": "event-attendance-app",
  "version": "1.0.0",
  "description": "Aplikasi Web Daftar Hadir Peserta Event Berbasis Barcode & QR Code",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "build": "npm --prefix client install && npm --prefix client run build",
    "server": "node server/server.js",
    "client": "npm --prefix client run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run server\" \"npm run client\""
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
